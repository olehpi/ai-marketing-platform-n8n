      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nconst output =\n  item.text ||\n  item.data ||\n  item.output ||\n  item.message?.text ||\n  \"\";\n\nconst isDeleteRequest =\n  output.toLowerCase().includes(\"delete my data\");\n\nconst senderId =\n$('Telegram Trigger').first().json.message.from.id\nreturn [{\n  json: {\n    senderId,\n    output,\n    isDeleteRequest\n  }\n}];"
      },
