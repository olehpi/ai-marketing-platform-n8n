      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nreturn data.results.map(result => {\n  const details = result.details || {};\n  const id = $('Message Found?').first().json.message_id +'_'+ result.value\n  return {\n    json: {\n      id: id,\n      type: result.actual_type ?? '',\n      user_name: result.value,\n      user_name_short: details.username,\n      user_id: details.id,\n      user_title: details.title ?? '',\n      message_id: $('Message Found?').first().json.message_id,\n      date: $('Message Found?').first().json.date,\n      extract_message_from_chat: $('Message Found?').first().json.text,\n      chat_id: $('Message Found?').first().json.chat_id,\n      chat_title: $('Message Found?').first().json.chat_title,\n      chat_username: $('Message Found?').first().json.sender_username,\n      sender_id: $('Message Found?').first().json.sender_id,\n      sender_username: $('Message Found?').first().json.sender_username,\n      sender_first_name: $('Message Found?').first().json.sender_first_name,\n      sender_last_name: $('Message Found?').first().json.sender_last_name,\n      sender_phone: $('Message Found?').first().json.sender_phone,\n      Status: result.is_correct ? 'correct' : 'incorrect',\n    }\n  };\n});"
