        "jsCode": "const groups = $input.all()\n    .map(item => ({\n        group: item.json.group,\n        limit: Number(item.json.limit) || 0\n    }))\n    .filter(item => item.group && item.limit > 0);\n\nreturn [\n    {\n        json: {\n            groups\n        }\n    }\n];"
