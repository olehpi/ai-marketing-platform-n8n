    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nconst sourceType = input.sourceType;\n\nconst outputForAdmin =\n  \"🆔 chat_id: \" + input.chatId +\n  \"  from \" + sourceType +\n  \"\\n👤 \" + input.user + \": \" + input.inputMessage +\n  \"\\n🤖 AI-assistant: \" + input.output +\n  \"\\n\\nReply to https://t.me/\" + input.userName;\n\nreturn [\n  {\n    json: {\n      \"output for client\": input.output,\n      \"output for admin\": outputForAdmin,\n      \"output for tech support\": outputForAdmin\n    }\n  }\n];"
      },
